# WMEval Lite case data is hosted on the Hugging Face Hub (lmgame/WMEval-Lite);
# fetch it with `python tools/sync_lite_data.py download`. Only the checksum
# manifests (and each case.yaml) stay in this repository.
eval_sets/wmeval_lite_v1/cases/*/*/reference/*
!eval_sets/wmeval_lite_v1/cases/*/*/reference/checksums.sha256
