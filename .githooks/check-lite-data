#!/bin/sh
# Warn when WMEval Lite case data needs a (re-)download after a checkout, merge or pull.
#
# Case data lives in git-ignored files under lite/cases/*/*/reference/
# (downloaded from Hugging Face). Checking out a commit from before that data left git,
# and then moving forward again, makes git delete those files; a branch with a different
# DATASET_REVISION expects a different dataset version. This never blocks git.
#
# Enable once per clone:  git config core.hooksPath .githooks
old="$1"; new="$2"
root=$(git rev-parse --show-toplevel) || exit 0
cd "$root" || exit 0
[ -f tools/sync_lite_data.py ] || exit 0
py=.venv/bin/python; [ -x "$py" ] || py=$(command -v python3) || exit 0

pin=lite/DATASET_REVISION
if [ -n "$old" ] && [ -n "$new" ] && [ "$old" != "$new" ] && ! git diff --quiet "$old" "$new" -- "$pin" 2>/dev/null; then
    echo "wmeval: this checkout pins a different dataset revision ($(cat "$pin" 2>/dev/null | cut -c1-10))."
    echo "        run: python tools/sync_lite_data.py download   (add --split full for test_full)"
    exit 0
fi
out=$("$py" tools/sync_lite_data.py status 2>/dev/null); rc=$?
if [ "$rc" -ne 0 ]; then
    echo "wmeval: case data is incomplete ($(printf '%s\n' "$out" | tail -n 1))."
    echo "        run: python tools/sync_lite_data.py download   (add --split full for test_full)"
fi
exit 0
